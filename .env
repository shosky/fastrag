# ============================================================
# FastRAG 本地开发环境变量（不提交到 git）
# 从 .env.example 复制并填入实际值
# ============================================================

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=123456

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_HOST=39.97.60.18
RABBITMQ_USER=fastrag
RABBITMQ_PASSWORD=fastrag123

# --- JWT ---
JWT_SECRET=请使用至少32字节的随机字符串

# --- Milvus ---
MILVUS_HOST=39.97.60.18

# --- Neo4j ---
NEO4J_ENABLED=true
NEO4J_URI=bolt://39.97.60.18:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fastrag123

# --- MinIO ---
MINIO_HOST=39.97.60.18
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- 微信小程序 ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- AI Gateway ---
AI_GATEWAY_URL=https://api.siliconflow.cn/v1

# --- ASR / OCR ---
ASR_API_KEY=sk-xxx

# --- OnlyOffice Document Server ---
# 启用后,FastRAG 会通过 OO 在线渲染 / 编辑 Office 文档
ONLYOFFICE_ENABLED=true
ONLYOFFICE_URL=http://localhost:8082
ONLYOFFICE_INTERNAL_URL=http://localhost:8082
ONLYOFFICE_JWT_SECRET=fastrag-onlyoffice-dev-secret-change-me
ONLYOFFICE_CALLBACK_BASE_URL=http://host.docker.internal:8081
ONLYOFFICE_STORAGE_BASE_URL=http://host.docker.internal:8081
